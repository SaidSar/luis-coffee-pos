generator client {
  provider = "prisma-client-js"
  // Carga los include con un solo query (JOIN LATERAL) en vez de uno por relación
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooler (pgbouncer, puerto 6543): la app
  directUrl = env("DIRECT_URL")   // conexión de sesión (puerto 5432): db push y migraciones
}

// ─── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  WAITER
  DELIVERY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MERGED // mesa secundaria unida a una principal (la orden vive en la principal)
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  OPEN
  IN_KITCHEN
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// ─── Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  active             Boolean   @default(true)  // false = no puede iniciar sesión (nunca se borra)
  tokenVersion       Int       @default(0)     // al subir invalida todos los JWT emitidos antes
  mustChangePassword Boolean   @default(false) // contraseña temporal: obliga a cambiarla al ingresar
  lastLoginAt        DateTime?

  orders     Order[]
  deliveries Delivery[] @relation("EmployeeDeliveries")
  expenses   Expense[]  @relation("ExpenseCreatedBy")
  payroll    Expense[]  @relation("ExpenseEmployee")
  splitsCreated OrderSplit[] @relation("SplitCreatedBy")
  shiftsOpened CashShift[] @relation("ShiftOpenedBy")
  shiftsClosed CashShift[] @relation("ShiftClosedBy")
}

model Table {
  id           String      @id @default(uuid())
  number       Int         @unique
  capacity     Int
  status       TableStatus @default(AVAILABLE)
  active       Boolean     @default(true) // false = desactivada (no aparece en el POS)
  mergedIntoId String?                    // mesa principal del grupo (solo en secundarias)

  mergedInto   Table?  @relation("TableMerge", fields: [mergedIntoId], references: [id])
  mergedTables Table[] @relation("TableMerge")
  orders       Order[]

  @@index([mergedIntoId])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  trackStock  Boolean  @default(false) // si es false, el stock no se valida ni se descuenta
  imageUrl    String?
  isAvailable Boolean  @default(true)
  categoryId  String

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  ticketNumber Int         @unique @default(autoincrement())
  customerName String?
  tableId      String?
  userId       String
  type         OrderType   @default(DINE_IN)
  status       OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  paidAt    DateTime?   // se fija al saldarse toda la orden (fecha de venta en reportes)

  table    Table?       @relation(fields: [tableId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  items    OrderItem[]
  splits   OrderSplit[]
  payments Payment[]
  delivery Delivery?

  @@index([paidAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  unitCost  Decimal  @default(0) @db.Decimal(10, 2) // costo del producto al momento del pedido
  notes     String?
  createdAt DateTime @default(now()) // orden cronológico de las rondas

  order      Order            @relation(fields: [orderId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])
  splitItems OrderSplitItem[]
}

// Cuenta: grupo de unidades de la orden que se cobra junto (cobrar todo = una cuenta con todo lo restante)
model OrderSplit {
  id          String   @id @default(uuid())
  orderId     String
  label       String?
  amount      Decimal  @db.Decimal(10, 2) // subtotal de sus unidades (+ cargo de envío si es la cuenta de una entrega)
  createdById String
  createdAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id])
  createdBy User             @relation("SplitCreatedBy", fields: [createdById], references: [id])
  items     OrderSplitItem[]
  payments  Payment[]

  @@index([orderId])
}

model OrderSplitItem {
  id          String @id @default(uuid())
  splitId     String
  orderItemId String
  quantity    Int    // > 0 (validado en la API)

  split     OrderSplit @relation(fields: [splitId], references: [id])
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id])

  @@index([splitId])
  @@index([orderItemId])
}

// Porción de una cuenta pagada con un método. amount = lo aplicado (nunca lo recibido);
// amountReceived y changeGiven solo en efectivo.
model Payment {
  id             String        @id @default(uuid())
  orderId        String
  splitId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  amountReceived Decimal?      @db.Decimal(10, 2)
  changeGiven    Decimal?      @db.Decimal(10, 2)
  paidAt         DateTime      @default(now())

  order Order      @relation(fields: [orderId], references: [id])
  split OrderSplit @relation(fields: [splitId], references: [id])

  @@index([orderId])
  @@index([splitId])
  @@index([paidAt])
}

model Delivery {
  id          String         @id @default(uuid())
  orderId     String         @unique
  employeeId  String?        // repartidor como usuario del sistema (opcional; hoy se usa driverName)
  address     String
  phone       String         // 10 dígitos, normalizado
  reference   String?
  deliveryFee Decimal        @default(0) @db.Decimal(10, 2)
  driverName  String?        // obligatorio al pasar a IN_TRANSIT
  status      DeliveryStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  inTransitAt DateTime?
  deliveredAt DateTime?

  order    Order @relation(fields: [orderId], references: [id])
  employee User? @relation("EmployeeDeliveries", fields: [employeeId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String   // una de EXPENSE_CATEGORIES (validada en la API)
  expenseDate DateTime @default(now()) // mediodía hora de Mazatlán del día del gasto
  notes       String?
  paidFromCash Boolean @default(false) // salió del efectivo de la caja (resta en el corte)
  createdAt   DateTime @default(now()) // instante de registro: ubica el gasto dentro de un turno de caja
  employeeId  String?  // nómina: empleado al que se pagó (sin cascada: los usuarios nunca se borran)

  user     User  @relation("ExpenseCreatedBy", fields: [userId], references: [id])
  employee User? @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}
// Turno de caja. Solo puede haber uno abierto (closedAt null); se garantiza en la API con un candado.
// Al cerrar se congela expectedCash (fondo + ventas en efectivo − gastos de caja del turno) y la diferencia.
// Un turno cerrado es inmutable (la API no expone edición ni borrado).
model CashShift {
  id           String    @id @default(uuid())
  openedById   String
  openedAt     DateTime  @default(now())
  openingFloat Decimal   @db.Decimal(10, 2)
  closedById   String?
  closedAt     DateTime?
  countedCash  Decimal?  @db.Decimal(10, 2)
  expectedCash Decimal?  @db.Decimal(10, 2)
  difference   Decimal?  @db.Decimal(10, 2) // contado − esperado (+ sobrante, − faltante)
  notes        String?

  openedBy User  @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User? @relation("ShiftClosedBy", fields: [closedById], references: [id])

  @@index([openedAt])
  @@index([closedAt])
}
