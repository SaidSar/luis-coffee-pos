# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# ── Servidor ─────────────────────────────────────────────
PORT=
NODE_ENV=
# Origen permitido por CORS y Socket.IO (p. ej. la URL del frontend en desarrollo)
FRONTEND_URL=

# ── Base de datos (Prisma) ───────────────────────────────
DATABASE_URL=
# Opcional: hoy schema.prisma no lo usa (sin directUrl)
DIRECT_URL=

# ── Autenticación ────────────────────────────────────────
JWT_SECRET=

# ── Cloudinary (imágenes de productos) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── IA: escaneo de menú con Gemini ───────────────────────
GEMINI_API_KEY=
# Opcional: modelo de Gemini. Si se deja vacío se usa gemini-3.5-flash
GEMINI_MODEL=

# Opcional: solo para src/services/anthropic.service.ts, que hoy no está en uso
ANTHROPIC_API_KEY=

# ── Seed (npm run db:seed) ───────────────────────────────
# Opcionales: el admin solo se crea si EMAIL y PASSWORD están definidos
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
